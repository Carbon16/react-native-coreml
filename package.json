{
  "name": "react-native-coreml-nitro",
  "author": "Leo G Skingley <lgs1g24@soton.ac.uk>",
  "version": "0.1.2",
  "description": "React Native Nitro module bridging CoreML to JavaScript with runtime model updates",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "ios",
    "plugin",
    "app.plugin.js",
    "nitro.json",
    "react-native-coreml-nitro.podspec"
  ],
  "expo": {
    "plugin": "./app.plugin.js"
  },
  "scripts": {
    "codegen": "nitrogen",
    "codegen:check": "nitrogen",
    "typecheck": "tsc --noEmit",
    "verify": "bun run codegen:check && bun run typecheck"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=7.0.0",
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*"
  },
  "devDependencies": {
    "nitrogen": "latest",
    "react-native-nitro-modules": "*",
    "typescript": "^5.6.0"
  }
}
