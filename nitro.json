{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["coreml"],
  "ios": {
    "iosModuleName": "NitroCoreML"
  },
  "android": {
    "androidNamespace": ["coreml"],
    "androidCxxLibName": "NitroCoreML"
  },
  "autolinking": {
    "CoreMLBridge": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridCoreMLBridge"
      }
    }
  },
  "ignorePaths": ["**/node_modules", "**/example"]
}
